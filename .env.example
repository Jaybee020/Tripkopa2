# Auto-generated from lib/services/manifest.json

# ── Supabase ──
# Your Supabase project URL (Project Settings -> API).
# required: true
NEXT_PUBLIC_SUPABASE_URL=https://abcdefgh.supabase.co

# Public anon key — safe to expose in the browser. Used for public client operations.
# required: true
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service-role key — server-side only. Bypasses RLS. Required when using `supabase.admin`.
# required: false
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service_role...

# ── Paystack ──
# Paystack secret key (sk_test_... or sk_live_...). Server-side only — never expose.
# required: true
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx

# Paystack public key (pk_test_... or pk_live_...). Used by the inline checkout widget in the browser.
# required: false
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx

# ── QoreID ──
# QoreID client ID (from Dashboard -> API Keys). Used to obtain a Bearer token at /token.
# required: true
QOREID_CLIENT_ID=qoreid_live_xxxxxxxxxxxx

# QoreID client secret (from Dashboard -> API Keys). Server-side only — never expose.
# required: true
QOREID_CLIENT_SECRET=qoreid_secret_xxxxxxxxxxxx

# Override the API base URL. Defaults to https://api.qoreid.com — only set this for testing or self-hosted proxies.
# required: false
QOREID_BASE_URL=https://api.qoreid.com

# Secret used to verify inbound QoreID webhook signatures (HMAC-SHA512 over raw body, sent as x-qoreid-signature). Only required if you receive webhooks.
# required: false
QOREID_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ── Resend ──
# Resend API key (re_...). Create one at https://resend.com/api-keys.
# required: true
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# Default sender address (must be on a verified domain).
# required: false
RESEND_FROM_EMAIL=noreply@example.com

# ── Meta WhatsApp Cloud API ──
# Required whenever WHATSAPP is included in a notification channel list.
# Server-side only — never expose this token to the browser or agent payloads.
WHATSAPP_ACCESS_TOKEN=your-meta-access-token

# WhatsApp Business phone number ID used as the sender.
WHATSAPP_PHONE_NUMBER_ID=your-business-phone-number-id

# Meta Graph API version. Defaults to v24.0 when omitted.
WHATSAPP_API_VERSION=v24.0

# Optional fallback recipient for one-off sendText tests. Production
# notifications pass each customer's stored number dynamically.
WHATSAPP_RECIPIENT=2348012345678

# ── Notification routing ──
# Global comma-separated fallback used when a per-notification setting is absent.
# Supported channels currently: EMAIL, WHATSAPP.
NOTIFICATION_CHANNELS=WHATSAPP

# Per-notification overrides. Include multiple comma-separated channels to fan out.
KYC_SUCCESS_NOTIFICATION_CHANNELS=EMAIL,WHATSAPP
REPAYMENT_REMINDER_NOTIFICATION_CHANNELS=WHATSAPP

# Protects Vercel Cron endpoints. Vercel sends this value as a Bearer token.
CRON_SECRET=replace-with-a-long-random-secret

# Comma-separated calendar-day offsets. The defaults send 7, 3, and 1 day
# before an installment, on its due date, and 1, 2, 3, and 7 days overdue.
REPAYMENT_REMINDER_DAYS_BEFORE=7,3,1,0
REPAYMENT_OVERDUE_REMINDER_DAYS=1,2,3,7
REPAYMENT_REMINDER_BATCH_SIZE=500

# ── PostHog ──
# PostHog project API key.
# required: true
POSTHOG_API_KEY=

# PostHog instance URL.
# required: false
POSTHOG_HOST=

# ── Added by consistency check: referenced in code but undeclared ──
# referenced in app/api/kyc/sessions/[session_id]/consent/route.ts
KYC_PROVIDER_URL=
# referenced in app/api/kyc/sessions/route.ts
NEXT_PUBLIC_APP_URL=
# referenced in app/api/kyc/sessions/[session_id]/consent/route.ts
QOREID_LAUNCH_URL=
# referenced in lib/services/taketrips.ts
TAKETRIPS_API_KEY=
# referenced in lib/services/taketrips.ts
TAKETRIPS_BASE_URL=
